rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/logins/$(request.auth.uid));
    }
    match /files/{file} {
      allow read, delete: if isMember();
      allow create: if isMember()
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
